F_S = 44100

def osc(f_0: float, N: int, n: int = 0) -> pq.Audio:
  t = (n + np.arange(N)) / F_S
  samples = np.sin(2.0 * np.pi * f_0 * t)
  return pq.Audio(samples, F_S)

N = 44100  # Total duration in samples (here, 1.0s)

# Sample-by-sample: minimal memory usage, maximal function overhaed
sample_by_sample = []
for n in range(N):
  sample_a = adenv(0.1, 0.9, 1, n)
  sample_b = osc(220.0, 1, n)
  sample_by_sample.append(sample_a * sample_b)
sample_by_sample = pq.Audio.concatenate(sample_by_sample)

# Ugen-by-ugen: maximal memory usage, minimal function overhead
ugen_a = adenv(0.1, 0.9, N, 0)
ugen_b = osc(220.0, N, 0)
ugen_by_ugen = ugen_a * ugen_b
assert np.allclose(ugen_by_ugen, sample_by_sample)

# Block-by-block: manageable memory usage, manageable function overhead
B = 441  # Block size (here, 0.01s)
block_by_block = []
for n in range(0, N, B):
  block_a = adenv(0.1, 0.9, B, n)
  block_b = osc(220.0, B, n)
  block_by_block.append(block_a * block_b)
block_by_block = pq.Audio.concatenate(block_by_block)
assert np.allclose(block_by_block, sample_by_sample)
