Unit generator implementation options:

```py
F_S = 44100

# As a function of time (n), managed elsewhere
def osc(f_0: float, N: int, n: int = 0) -> pq.Audio:
  t = (n + np.arange(N)) / F_S
  samples = np.sin(2.0 * np.pi * f_0 * t)
  return pq.Audio(samples, F_S)

# As a function of state, returned by the function
def osc_stateless(f_0: float, N: int, initial_phase: Optional[float] = None) -> pq.Audio, float:
  d_phase = (2.0 * np.pi * self.f_0) / F_S
  phase = initial_phase + (np.arange(N) * d_phase)
  samples = np.sin(phase)
  return pq.Audio(samples, F_S), phase + N * d_phase

# As an iterator over blocks
def osc_iter(f_0: float, N: int) -> Iterator[pq.Audio]:
  phase = None
  while True:
    block, phase = osc_stateless(f_0, N, initial_phase=phase)
    yield block

# As a stateful class
class OscStateful:
  def __init__(f_0: float):
    self.d_phase = (2.0 * np.pi * self.f_0) / F_S
    self.reset()

  def reset(self):
    self.phase = 0.0

  def __call__(self, N: int) -> pq.Audio:
    phase = np.arange(N) * self.d_phase
    samples = np.sin(phase)
    self.phase += N * self.d_phase
    return pq.Audio(samples, F_S)

f_0 = 220.0
B = 441
a, b, c, d = [], [], [], []
b_state = None
c_iter = osc_iter(f_0, B)
d_instance = OscStateful(f_0)
